NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# MongoDB Configuration (Local Replica Set or Atlas Cloud):
# Local: MONGODB_URI=mongodb://127.0.0.1:27018/nilami?replicaSet=rs0
# Atlas: MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nilami?retryWrites=true&w=majority
MONGODB_DB_NAME=nilami
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nilami?retryWrites=true&w=majority

REDIS_URL=redis://127.0.0.1:6380
JWT_ACCESS_SECRET=change-me-32+chars-change-me-32+chars
JWT_REFRESH_SECRET=change-me-too-32+chars-change-me-too
ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
IP_HASH_SECRET=change-me-3

# Email / SMTP (Mailpit local OR Gmail SMTP)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_SECURE=false
SMTP_SERVICE=gmail
MAIL_FROM="Nilami <your_email@gmail.com>"

# Storage Driver: local | cloudinary | s3
STORAGE_DRIVER=s3
UPLOAD_DIR=./uploads
CLOUDINARY_URL=
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your_bucket_name
AWS_S3_ENDPOINT=
AWS_S3_PUBLIC_URL=

# Payment Provider: razorpay | stripe | mock
PAYMENT_PROVIDER=razorpay
CURRENCY=INR
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PAYMENT_WINDOW_MINUTES=2880

ANTI_SNIPE_WINDOW_MS=10000
ANTI_SNIPE_EXTEND_MS=30000
ANTI_SNIPE_MAX_EXTENSIONS=20
RUN_WORKER_IN_API=false
LOG_LEVEL=debug
